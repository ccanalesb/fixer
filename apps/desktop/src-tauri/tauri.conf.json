{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fixer",
  "version": "../../../package.json",
  "identifier": "com.ccanales.fixer",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fixer",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../staged-resources/": "fixer-resources/"
    },
    "externalBin": ["binaries/node"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
