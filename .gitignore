# No trailing slash: Sandcastle symlinks the pre-baked dependency trees into the
# worktree, and `node_modules/` matches directories only, so the symlink read as
# a tracked file and got committed once already.
node_modules
dist/
coverage/
*.tsbuildinfo
.eslintcache

# `tests/fixtures/imaging/regenerate-fixtures.py` is still run by hand after a
# Pillow upgrade; it drops bytecode next to itself. The only other Python is the
# models' converter, `scripts/app-models/export_onnx.py`, run through uv.
__pycache__/
*.py[cod]
.venv
venv/

.env
.env.local
config.yaml
apps/visualizer/backend/providers.json
apps/visualizer/backend/*.crt
apps/visualizer/backend/*.key

*.db
*.db-journal
*.db-wal
*.db-shm
library.db*.bak
library.db*.bak-shm
library.db*.bak-wal
library.db.worktree-backup
# Written next to library.db by the user_version 6→7 migration (#228) — contains
# exported Instagram matching rows, never belongs in the repo.
instagram-matching-export.json
library.json
vision_matching_results.json
# The models in this app, written by `scripts/app-models/export_onnx.py`. The repo is public;
# no model is ever committed.
/models/

logs
*.log
artifacts/*
thumbnails/
.agent-browser-shots/*
validation_report.html
.run

# Agent tooling: local to a machine. `.cursor/rules`, `.cursor/hooks` and
# `.cursor/skills` stay tracked — Sandcastle runs agents from a repo checkout
# and reads its guardrails from there.
.claude/
.cursor/worktrees.json
.agents/
.opencode/
.codebuddy/*
.augment/*
.worktrees/
skills-lock.json
instructions.md
scripts/ui-audit.mjs
scripts/.autopilot-ledger.json

.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.komodoproject
*.code-workspace

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Desktop app build artifacts
apps/desktop/staged-resources/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/target/
